# Copy to .env.local for local development. Keep it outside source control.
DATABASE_URL=postgresql://neondb_owner:your password.neon.tech/neondb?sslmode=require&channel_binding=require
APP_URL=http://127.0.0.1:5173
# Generate at least 32 random characters; required for first owner creation in production.
OWNER_SETUP_TOKEN=?
# Development on loopback only. This flag never bypasses the production token.
ALLOW_LOCAL_SETUP=false
DATA_DIR=./.data
# Directory containing eng.traineddata. The included verified model is portable.
TESSERACT_LANG_PATH=./runtime/ocr
# Leave unset when pdftotext/pdfinfo/pdftoppm are on PATH.
# POPPLER_BIN=/usr/bin
# Production port: npm start listens on all interfaces behind your HTTPS reverse proxy.
PORT=3000

# Optional local-only test databases; never point these at the live database.
# TEST_DATABASE_URL=postgresql://sanket:CHANGE_ME@127.0.0.1:5432/sanket_domain_test
# TEST_HTTP_DATABASE_URL=postgresql://sanket:CHANGE_ME@127.0.0.1:5432/sanket_test
